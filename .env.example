# Copy of the values setup-env.ps1 writes into .env (never commit the real file).
# ERPNEXT_URL is the base URL of your ERPNext instance, no trailing slash.
ERPNEXT_URL=http://localhost:8000
ERPNEXT_SITE=frontend

# "token <api_key>:<api_secret>" - built by setup-env.ps1 from ERPNEXT_API_TOKEN.
# Sent only by Lowdefy's server-side AxiosHttp connection, never to the browser.
ERPNEXT_AUTH_HEADER=token CHANGE_ME

# Absolute path to the local SQLite file used for the audit log and settings.
COPILOT_DB_PATH=C:/path/to/erpnext-copilot/data/copilot.sqlite

# Local Copilot data service (aggregation + audit log). Lowdefy calls it over HTTP.
COPILOT_API_URL=http://127.0.0.1:4010
COPILOT_API_PORT=4010

# Where the camera scanner page sends scanned codes back to (the Lowdefy app).
COPILOT_APP_URL=http://localhost:3010

# Random string used for Lowdefy's auth secret (only needed once auth is enabled).
LOWDEFY_SECRET=CHANGE_ME

# Read by the Lowdefy app through _secret: COPILOT_API_URL (server-side only).
LOWDEFY_SECRET_COPILOT_API_URL=http://127.0.0.1:4010

# Dashboard secrets (Pipeline Status / Orders pages) — read-only copies from the
# source ERPNext project. Never committed; values are filled by setup-env.ps1.
LOWDEFY_SECRET_ERP_TOKEN=CHANGE_ME
LOWDEFY_SECRET_SHOPIFY_STORE=CHANGE_ME.myshopify.com
LOWDEFY_SECRET_SHOPIFY_TOKEN=CHANGE_ME
